# ── Firebase Admin SDK ────────────────────────────────────────
# Base64-encode your Firebase service account JSON.
# To encode: python -c "import base64; print(base64.b64encode(open('service-account.json','rb').read()).decode())"
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json_here

# Firebase project ID
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here.appspot.com

# ── OpenAI ────────────────────────────────────────────────────
# Used for GPT-4o mini Vision API verification of eco actions
OPENAI_API_KEY=your_openai_api_key_here

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ── Cloudinary ──────────────────────────────────────────────
# Used for uploading media files (images/videos) of eco actions
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── JWT Authentication ────────────────────────────────────────
# A long random string used to sign the custom JWT tokens
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
